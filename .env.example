# --- Telegram ---
BOT_TOKEN=

# --- Proggaa website / API (used later, once the real integration exists) ---
PROGGAA_WEB_URL=https://your-proggaa-domain.com
PROGGAA_API_URL=https://api.your-proggaa-domain.com
PROGGAA_API_KEY=

# --- Persistence (only needed once you move off in-memory mock storage) ---
DATABASE_URL=postgresql://user:password@localhost:5432/proggaa_bot

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Bot connection mode ---
# "polling": default, used for local development (npm run dev).
# "webhook": used in production on free hosts like Render, whose free
# tier only supports HTTP web services, not always-on background workers.
BOT_MODE=polling

# Only needed when BOT_MODE=webhook. Public HTTPS URL Telegram sends
# updates to. On Render this is provided automatically as
# RENDER_EXTERNAL_URL, so you usually don't need to set this yourself —
# only set WEBHOOK_URL if deploying somewhere that doesn't provide it.
WEBHOOK_URL=

# Only needed when BOT_MODE=webhook. Random secret path segment so the
# webhook URL isn't guessable. Generate one locally with:
#   openssl rand -hex 20
WEBHOOK_SECRET_PATH=

# Only needed when BOT_MODE=webhook. Render sets this automatically;
# only set it yourself for local webhook testing.
PORT=3000

# --- Feature flags: which provider implementation to use for each service ---
# "mock" is the only supported value today. Set to "api" once real
# ApiProggaa*Service implementations exist and are wired in the container.
# One switch for everything the website can answer: mock (demo data) or api (the real website).
# Individual PROGGAA_<SERVICE>_PROVIDER lines below override it.
PROGGAA_PROVIDER=mock
# Same value as PROGGAA_BOT_WEBHOOK_SECRET on the website. Lets the website push events
# (exam starting, results, payment approved/rejected, announcements) to POST /proggaa/events.
PROGGAA_BOT_WEBHOOK_SECRET=
PROGGAA_ACHIEVEMENT_PROVIDER=
PROGGAA_USER_PROVIDER=
PROGGAA_COURSE_PROVIDER=
PROGGAA_EXAM_PROVIDER=
PROGGAA_RESULT_PROVIDER=
PROGGAA_PAYMENT_PROVIDER=
PROGGAA_NOTIFICATION_PROVIDER=
PROGGAA_AI_PROVIDER=
PROGGAA_ADMIN_PROVIDER=
PROGGAA_LINK_PROVIDER=

# --- Security ---
# Comma separated numeric Telegram user IDs allowed to bypass nothing —
# used only for local dev seeding of the mock admin account.
DEV_SEED_ADMIN_TELEGRAM_ID=

# --- Group Assistant ---
# Comma-separated Telegram chat ids (negative numbers, e.g. from
# @RawDataBot or getUpdates) for the group(s) where the bot should act as
# Group Assistant — welcome new members, answer FAQs, moderate, and receive
# admin group announcements. Any group not listed here is left alone even
# if the bot is a member of it.
PROGGAA_GROUP_IDS=

# --- Persistence ---
# Directory for the bot's own state (support tickets, account links, group
# config, notification history/preferences) as JSON files. On Render,
# point this at a mounted Disk's path (e.g. /var/data) so it survives
# redeploys. Leave unset for in-memory-only — fine for local dev, but
# every restart loses all of the above.
PERSISTENCE_DIR=
