# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
# From @BotFather. Keep it secret; revoke it with /revoke if it ever leaks.
BOT_TOKEN=

# --- Proggaa (the website) ---
# The public address of the website, no trailing slash. Every link the bot sends uses it.
PROGGAA_WEB_URL=https://your-proggaa-site.example
# Where the bot calls /api/bot/*. Leave empty to use PROGGAA_WEB_URL (the API is part of the same site).
PROGGAA_API_URL=
# Must be EXACTLY the website's PROGGAA_API_KEY (at least 16 characters; generate with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
PROGGAA_API_KEY=

# --- Connection mode ---
# polling: the bot pulls updates from Telegram (local use).
# webhook: Telegram pushes updates to an HTTPS endpoint (Render and other web hosts).
BOT_MODE=polling

# Webhook mode only:
# Public base URL of this bot. On Render this is provided as RENDER_EXTERNAL_URL, so leave it empty there.
WEBHOOK_URL=
# A random string of at least 16 characters. Becomes the private path Telegram posts to; a secret
# header derived from it is also checked on every request.
WEBHOOK_SECRET_PATH=
# Ping our own /healthz every 10 minutes so a free Render service does not sleep. Use "off" on a paid host.
KEEP_ALIVE=on
# Port to listen on (Render sets it).
PORT=3000

# --- Notifications ---
# How often to ask the website for new notifications, in seconds (15 to 3600).
RELAY_INTERVAL_SECONDS=60
# With no saved position (first start, or no disk), look back this many minutes so a restart
# does not drop what happened just before it.
RELAY_LOOKBACK_MINUTES=30

# --- Optional ---
# A folder for the bot's own small files (notification mutes, the notification position, group
# settings). On Render use a mounted Disk. Empty means memory only, which resets on every restart.
PERSISTENCE_DIR=
# Comma-separated Telegram group ids (negative numbers) where the Group Assistant is active.
PROGGAA_GROUP_IDS=
NODE_ENV=development
LOG_LEVEL=info
