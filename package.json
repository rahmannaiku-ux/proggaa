{
  "name": "proggaa-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Telegram Bot for the Proggaa LMS platform. Built against clean service interfaces with mock implementations, ready to be wired to the real Proggaa API later.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "@prisma/client": "^5.19.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "prisma": "^5.19.1",
    "vitest": "^2.0.5",
    "@types/node": "^20.14.15"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
